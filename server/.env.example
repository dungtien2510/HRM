# Sao chép thành .env (KHÔNG commit .env). Script deploy/windows/03_tao_tep_env.ps1 sẽ tự sinh các bí mật.
# Chỉ đọc lúc khởi động. Biến môi trường của hệ điều hành/dịch vụ được ưu tiên hơn file này.

NODE_ENV=production

# --- HTTPS (bắt buộc; API không phục vụ HTTP) ---
DIA_CHI_LANG_NGHE=0.0.0.0
CONG=8443
TLS_PFX=C:\HRM\chung_chi\hrm_may_chu.pfx
TLS_PFX_MAT_KHAU=

# --- MongoDB (chỉ chấp nhận 127.0.0.1 / localhost) ---
MONGO_MAY=127.0.0.1
MONGO_CONG=27017
MONGO_CSDL=hrm_nhan_su
MONGO_NGUOI_DUNG=hrm_ung_dung
MONGO_MAT_KHAU=

# --- Phiên đăng nhập ---
# Chuỗi ngẫu nhiên từ 48 ký tự trở lên. Đổi giá trị này sẽ vô hiệu mọi phiên đang đăng nhập.
JWT_BI_MAT=
JWT_HET_HAN_PHUT=30
BCRYPT_COST=12

# --- Giới hạn đăng nhập sai (trong cửa sổ thời gian; vượt ngưỡng thì khóa tạm đến khi lượt cũ hết hạn) ---
DANG_NHAP_SAI_TOI_DA_TAI_KHOAN=5
DANG_NHAP_SAI_TOI_DA_IP=20
DANG_NHAP_CUA_SO_PHUT=15

# --- Phiên bản ứng dụng tối thiểu: chỉ dùng để gieo giá trị lần đầu vào collection cau_hinh ---
PHIEN_BAN_TOI_THIEU_MAC_DINH=0.1.0
